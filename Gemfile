gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  # Add Jekyll plugins here if the site grows (e.g. jekyll-feed, jekyll-seo-tag).
end

# Windows / JRuby compatibility helpers (harmless elsewhere).
gem "webrick", "~> 1.8"
